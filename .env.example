# Set a unique owner password (16–256 characters) privately on the server.
# Existing email-only owner sessions are rejected after this update.
OWNER_PASSWORD=

# Optional services. Leave blank until reachable from this web process.
# These values are deployment settings; never paste wallet credentials here.
WORKSPACE_OLLAMA_URL=
WORKSPACE_CHAT_MODEL=qwen3:8b-q4_K_M
WORKSPACE_AI_TIMEOUT_MS=180000
VANE_URL=
VANE_CHAT_MODEL=qwen3:8b-q4_K_M
VANE_EMBEDDING_MODEL=nomic-embed-text

# For isolated staging only. Do not point staging at the production data volume.
ENABLE_LIVE_TRADING=false
EXECUTE_REAL_SWAPS=false
DISABLE_BACKGROUND_WORKERS=true
TRADE_LORD_DISABLED=true

# Optional private QR-code WhatsApp service. Use a random 32+ character token.
# Use the same token in the bridge. This token also protects saved session data.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
