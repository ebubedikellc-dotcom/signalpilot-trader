{$HUB_DOMAIN} {
  @owner not path /v1/chat
  basic_auth @owner {
    {$HUB_OWNER} {$HUB_PASSWORD_HASH}
  }
  header {
    X-Frame-Options DENY
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
  @restore path /api/import
  request_body @restore {
    max_size 21GB
  }
  @regular not path /api/import
  request_body @regular {
    max_size 100MB
  }
  reverse_proxy web:8080
}
